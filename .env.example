# Gmail Action Router - Environment Configuration
# Copy this to .env and fill in your values

# ===========================================
# SLACK CONFIGURATION
# ===========================================
# Get this from: https://api.slack.com/apps
# Your bot token starts with 'xoxb-'
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# The channel where email actions will be posted
# Make sure to invite your bot to this channel!
SLACK_CHANNEL=#email-actions

# ===========================================
# WHATSAPP (TWILIO) CONFIGURATION
# ===========================================
# Get these from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your personal WhatsApp number (format: whatsapp:+1234567890)
YOUR_WHATSAPP_NUMBER=whatsapp:+1234567890

# ===========================================
# NOTES
# ===========================================
# - Gmail authentication is done via OAuth, no credentials needed here
# - WhatsApp requires completing Twilio's sandbox setup first
# - Keep this file secret! Add it to .gitignore
