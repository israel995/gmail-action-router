# Gmail Action Router - Environment Configuration
# Copy this to .env and fill in your values

# ===========================================
# SLACK CONFIGURATION
# ===========================================
# Get these from: https://api.slack.com/apps
# Your bot token starts with 'xoxb-'
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# The channel where email actions will be posted
# Make sure to invite your bot to this channel!
SLACK_CHANNEL=#email-actions

# Signing secret for verifying Slack requests (required for interactivity)
# Found in: App Settings > Basic Information > Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# Channel for delegation notifications (optional)
DELEGATION_CHANNEL=#delegated-tasks

# ===========================================
# WHATSAPP (TWILIO) CONFIGURATION
# ===========================================
# Get these from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your personal WhatsApp number (format: whatsapp:+1234567890)
YOUR_WHATSAPP_NUMBER=whatsapp:+1234567890

# ===========================================
# AI CONFIGURATION (Optional)
# ===========================================
# Get from: https://console.anthropic.com/
# Leave empty to disable AI features
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Model to use for AI features (default: claude-sonnet-4-20250514)
AI_MODEL=claude-sonnet-4-20250514

# Minimum email length (chars) to trigger AI summarization (default: 500)
AI_SUMMARY_THRESHOLD=500

# ===========================================
# SENDER FILTERING
# ===========================================
# Comma-separated list of important senders (auto-elevated to HIGH priority)
IMPORTANT_SENDERS=boss@company.com,client@important.com

# Comma-separated list of senders to skip entirely
SKIP_SENDERS=noreply,notifications@,newsletter

# Comma-separated list of personal life senders (daycare, school, doctor, etc.)
PERSONAL_SENDERS=daycare@,school@,doctor@

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Flask server settings (for Slack interactivity)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# ===========================================
# EMAIL PROCESSING
# ===========================================
# Default number of hours to look back for emails (default: 168 = 7 days)
DEFAULT_SCAN_HOURS=168

# Maximum emails to fetch per request (default: 50)
MAX_EMAILS_PER_FETCH=50

# ===========================================
# SCHEDULING
# ===========================================
# Time for daily digest (24-hour format)
DAILY_DIGEST_HOUR=7
DAILY_DIGEST_MINUTE=0

# How often to check for due snoozes (minutes)
SNOOZE_CHECK_INTERVAL_MINUTES=15

# ===========================================
# DATABASE
# ===========================================
# Path to SQLite database file
DATABASE_PATH=email_agent.db

# ===========================================
# CEO CO-PILOT CONFIGURATION
# ===========================================

# Notion API key (get from https://www.notion.so/my-integrations)
# Leave empty to disable Notion integration
NOTION_API_KEY=secret_your_notion_api_key_here

# Notion database IDs (the long UUID in the database URL)
# e.g. https://notion.so/myworkspace/abc123...?v=xyz → ID is "abc123..."
NOTION_ACTION_ITEMS_DB=your_action_items_database_id
NOTION_PROJECTS_DB=your_projects_database_id

# VIP contacts to track (format: Name:email:Role:max_silence_hours)
# Multiple contacts separated by commas; silence_hours is optional (default 48)
# Example: Alice Smith:alice@company.com:CTO:24,Bob Lee:bob@company.com:VP Sales:48
VIP_CONTACTS=Alice Smith:alice@company.com:CTO:24,Bob Lee:bob@company.com:VP Sales:48

# Default hours of silence before alerting about a VIP contact (default: 48)
VIP_DEFAULT_SILENCE_HOURS=48

# Projects to track (format: ProjectName:keyword1+keyword2)
# Multiple projects separated by commas
# Example: Product Launch:launch+roadmap+Q3,Enterprise Deal:enterprise+contract
TRACKED_PROJECTS=Product Launch:launch+roadmap,Enterprise Deal:enterprise+deal

# Slack channel for co-pilot alerts/briefings (defaults to SLACK_CHANNEL)
COPILOT_CHANNEL=#ceo-copilot

# Co-pilot morning briefing time (24h, weekdays only)
COPILOT_BRIEFING_HOUR=8
COPILOT_BRIEFING_MINUTE=0

# How often to check for overdue VIPs and stalled projects (minutes, default: 480 = 8h)
COPILOT_CHECK_INTERVAL_MINUTES=480

# How often to sync action items from Notion (minutes, default: 480 = 8h)
NOTION_SYNC_INTERVAL_MINUTES=480

# ===========================================
# NOTES
# ===========================================
# - Gmail authentication is done via OAuth, no credentials needed here
# - WhatsApp requires completing Twilio's sandbox setup first
# - For Slack interactivity, you need to run the Flask server and use ngrok
# - Keep this file secret! Add it to .gitignore
# - CEO Co-pilot slash commands to register in Slack:
#   /copilot, /team, /projects, /followup, /add-vip, /remove-vip,
#   /add-project, /log-action
#   All pointing to: https://your-server/slack/commands
